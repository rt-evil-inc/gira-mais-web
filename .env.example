# Database connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gira

# Admin login credentials
ADMIN_LOGIN=admin:your_secure_admin_password_here

# Optional - set to 'production' in production environments
NODE_ENV=production

# Initial date
INITIAL_DATE=2025-04-27

# GitHub token used to read public repository data (listing stargazers requires authentication).
# Must be a classic token with the public_repo scope; fine-grained tokens cannot list stargazers.
GITHUB_TOKEN=ghp_your_token_here

# Poll the GIRA system (stations, docks and bikes) for the statistics page. On by default in production,
# off in development unless set to true; only one server per database should poll.
# GIRA_POLLING=true
# GIRA_POLLING_INTERVAL_MINUTES=5
# Hours without a bike after which a dock the system reports as free counts as suspicious (default 7 days).
# GIRA_SUSPICIOUS_DOCK_HOURS=168
# Hours without any change (no bike arriving or leaving) after which a station in service counts as idle (default 48).
# GIRA_IDLE_STATION_HOURS=48
