{
  "name": "gira-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "db:start": "docker run -d --name gira-web-db-dev -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=gira -p 5432:5432 postgres:14-alpine",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.5",
    "@internationalized/date": "~3.8.0",
    "@lucide/svelte": "^0.482.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/enhanced-img": "^0.6.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.1",
    "autoprefixer": "^10.5.4",
    "bits-ui": "^1.8.0",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "embla-carousel-svelte": "^8.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^2.46.1",
    "formsnap": "^2.0.1",
    "globals": "^15.15.0",
    "mdsvex": "^0.12.8",
    "mode-watcher": "0.5.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^0.3.28",
    "sveltekit-superforms": "^2.30.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^0.2.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "chart.js": "~4.4.9",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-autoplay": "^8.6.0",
    "jose": "^6.2.10",
    "lucide-svelte": "^0.503.0",
    "postgres": "^3.4.9",
    "rehype-urls": "^1.2.0"
  }
}